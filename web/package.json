{
  "name": "spectrafit-benchmark-web",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "description": "SpectraFit benchmark report UI — Vite + React; fetches the report from the FastAPI app at runtime.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:html": "NODE_OPTIONS=--max-old-space-size=4096 BUILD_HTML=1 vite build",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "biome check .",
    "contract": "openapi-typescript http://localhost:8000/openapi.json -o src/openapi.gen.ts",
    "check:contract": "node scripts/check-openapi-sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.16",
    "d3-format": "^3.1.0",
    "katex": "^0.18.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-format": "^3.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
